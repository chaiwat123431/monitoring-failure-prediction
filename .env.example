# Copy to .env for local development. Never commit the real .env (already gitignored).

# TimescaleDB
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=monitoring
POSTGRES_PORT=5432

# Redpanda (Kafka external listener, for host-side tools like rpk or the producer script)
REDPANDA_EXTERNAL_PORT=19092

# Backend / frontend host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
